{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Id": {"type": "string","pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "Name": {"type": "string","pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}(\\.[a-zA-Z0-9_-]{1,31})?$"},
    "Sha256": {"type": "string","pattern": "^[0-9a-f]{64}$"},
    "Capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name","revision"],
      "properties": {"name": {"type": "string","enum": ["traffic.k6"]},"revision": {"const": 1}}
    },
    "Register": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id","supported_minors","capabilities"],
      "properties": {
        "request_id": {"$ref": "#/$defs/Id"},
        "supported_minors": {
          "type": "array",
          "items": {"type": "integer","minimum": 0,"maximum": 65535},
          "maxItems": 32,
          "uniqueItems": true,
          "minItems": 1
        },
        "capabilities": {"type": "array","items": {"$ref": "#/$defs/Capability"},"maxItems": 32,"uniqueItems": true}
      }
    },
    "Registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id","session_id","minor","authorized_capabilities","unresolved"],
      "properties": {
        "agent_id": {"$ref": "#/$defs/Id"},
        "session_id": {"$ref": "#/$defs/Id"},
        "minor": {"const": 0},
        "authorized_capabilities": {"type": "array","items": {"$ref": "#/$defs/Capability"},"maxItems": 32,"uniqueItems": true},
        "unresolved": {"type": "array","items": {"$ref": "#/$defs/JobIdentity"},"maxItems": 32,"uniqueItems": true}
      }
    },
    "JobIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id","attempt_id","lease_id"],
      "properties": {"job_id": {"$ref": "#/$defs/Id"},"attempt_id": {"$ref": "#/$defs/Id"},"lease_id": {"$ref": "#/$defs/Id"}}
    },
    "Grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence","valid_for_ms"],
      "properties": {
        "sequence": {"type": "integer","minimum": 1,"maximum": 2147483647},
        "valid_for_ms": {"type": "integer","minimum": 1,"maximum": 2147483647}
      }
    },
    "Heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id","session_id"],
      "properties": {
        "request_id": {"$ref": "#/$defs/Id"},
        "session_id": {"$ref": "#/$defs/Id"},
        "owned": {
          "type": "object",
          "additionalProperties": false,
          "required": ["job_id","attempt_id","lease_id","process"],
          "properties": {
            "job_id": {"$ref": "#/$defs/Id"},
            "attempt_id": {"$ref": "#/$defs/Id"},
            "lease_id": {"$ref": "#/$defs/Id"},
            "process": {"type": "string","enum": ["not_started","running","exited","unknown"]}
          }
        }
      }
    },
    "Directive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id","attempt_id","lease_id","action"],
      "properties": {
        "job_id": {"$ref": "#/$defs/Id"},
        "attempt_id": {"$ref": "#/$defs/Id"},
        "lease_id": {"$ref": "#/$defs/Id"},
        "action": {"type": "string","enum": ["renew","cancel","reconcile"]},
        "grant": {"$ref": "#/$defs/Grant"}
      },
      "if": {"properties": {"action": {"const": "renew"}}},
      "then": {"required": ["grant"]},
      "else": {"not": {"required": ["grant"]}}
    },
    "HeartbeatReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {"directive": {"$ref": "#/$defs/Directive"}}
    },
    "Claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id","session_id"],
      "properties": {"request_id": {"$ref": "#/$defs/Id"},"session_id": {"$ref": "#/$defs/Id"}}
    },
    "K6Task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "revision",
        "workload_id",
        "workload_sha256",
        "target_id",
        "phase",
        "duration_ms",
        "arrival_rate_per_second",
        "response_bytes",
        "connection_reuse",
        "seed",
        "request_timeout_ms",
        "preallocated_vus"
      ],
      "properties": {
        "type": {"const": "traffic.k6"},
        "revision": {"const": 1},
        "workload_id": {"$ref": "#/$defs/Name"},
        "workload_sha256": {"$ref": "#/$defs/Sha256"},
        "target_id": {"$ref": "#/$defs/Name"},
        "phase": {"type": "string","enum": ["warmup","measurement"]},
        "duration_ms": {"type": "integer","minimum": 1,"maximum": 2147483647},
        "arrival_rate_per_second": {"type": "integer","minimum": 1,"maximum": 2147483647},
        "response_bytes": {"type": "integer","minimum": 0,"maximum": 2147483647},
        "connection_reuse": {"type": "boolean"},
        "seed": {"type": "integer","minimum": 0,"maximum": 9007199254740991},
        "request_timeout_ms": {"type": "integer","minimum": 1,"maximum": 2147483647},
        "preallocated_vus": {"type": "integer","minimum": 1,"maximum": 2147483647}
      }
    },
    "Assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id","attempt_id","lease_id","run_id","task","job_budget_ms","expected_artifacts"],
      "properties": {
        "job_id": {"$ref": "#/$defs/Id"},
        "attempt_id": {"$ref": "#/$defs/Id"},
        "lease_id": {"$ref": "#/$defs/Id"},
        "run_id": {"$ref": "#/$defs/Id"},
        "task": {"$ref": "#/$defs/K6Task"},
        "job_budget_ms": {"type": "integer","minimum": 1,"maximum": 2147483647},
        "expected_artifacts": {"type": "array","items": {"$ref": "#/$defs/Name"},"maxItems": 128,"uniqueItems": true}
      }
    },
    "Started": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id","session_id","attempt_id","lease_id"],
      "properties": {
        "request_id": {"$ref": "#/$defs/Id"},
        "session_id": {"$ref": "#/$defs/Id"},
        "attempt_id": {"$ref": "#/$defs/Id"},
        "lease_id": {"$ref": "#/$defs/Id"}
      }
    },
    "StartAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id","attempt_id","lease_id","grant"],
      "properties": {
        "job_id": {"$ref": "#/$defs/Id"},
        "attempt_id": {"$ref": "#/$defs/Id"},
        "lease_id": {"$ref": "#/$defs/Id"},
        "grant": {"$ref": "#/$defs/Grant"}
      }
    },
    "ArtifactReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name","sha256","bytes"],
      "properties": {
        "name": {"$ref": "#/$defs/Name"},
        "sha256": {"$ref": "#/$defs/Sha256"},
        "bytes": {"type": "integer","minimum": 0,"maximum": 9007199254740991}
      }
    },
    "Complete": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id","session_id","attempt_id","lease_id","process","exit_code","artifacts"],
      "properties": {
        "request_id": {"$ref": "#/$defs/Id"},
        "session_id": {"$ref": "#/$defs/Id"},
        "attempt_id": {"$ref": "#/$defs/Id"},
        "lease_id": {"$ref": "#/$defs/Id"},
        "process": {"const": "exited"},
        "exit_code": {"const": 0},
        "artifacts": {"type": "array","items": {"$ref": "#/$defs/ArtifactReceipt"},"maxItems": 128,"uniqueItems": true}
      }
    },
    "Fail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "session_id",
        "attempt_id",
        "lease_id",
        "process",
        "reason",
        "message",
        "artifacts",
        "missing_artifacts"
      ],
      "properties": {
        "request_id": {"$ref": "#/$defs/Id"},
        "session_id": {"$ref": "#/$defs/Id"},
        "attempt_id": {"$ref": "#/$defs/Id"},
        "lease_id": {"$ref": "#/$defs/Id"},
        "process": {"type": "string","enum": ["not_started","exited","unknown"]},
        "reason": {
          "type": "string",
          "enum": ["execution_error","timeout","cancelled","lease_expired","artifact_error","configuration_error"]
        },
        "message": {"type": "string","minLength": 1,"maxLength": 512},
        "artifacts": {"type": "array","items": {"$ref": "#/$defs/ArtifactReceipt"},"maxItems": 128,"uniqueItems": true},
        "missing_artifacts": {"type": "array","items": {"$ref": "#/$defs/Name"},"maxItems": 128,"uniqueItems": true},
        "exit_code": {"type": "integer","minimum": 0,"maximum": 255}
      }
    },
    "Reconcile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id","session_id","attempt_id","lease_id","process","message","artifacts","missing_artifacts"],
      "properties": {
        "request_id": {"$ref": "#/$defs/Id"},
        "session_id": {"$ref": "#/$defs/Id"},
        "attempt_id": {"$ref": "#/$defs/Id"},
        "lease_id": {"$ref": "#/$defs/Id"},
        "process": {"type": "string","enum": ["not_started","exited","unknown"]},
        "message": {"type": "string","minLength": 1,"maxLength": 512},
        "artifacts": {"type": "array","items": {"$ref": "#/$defs/ArtifactReceipt"},"maxItems": 128,"uniqueItems": true},
        "missing_artifacts": {"type": "array","items": {"$ref": "#/$defs/Name"},"maxItems": 128,"uniqueItems": true}
      }
    },
    "Reconciled": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition"],
      "properties": {"disposition": {"type": "string","enum": ["collect_evidence","closed","recovery_required"]}}
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code","message","retryable"],
      "properties": {
        "code": {"$ref": "#/$defs/Name"},
        "message": {"type": "string","minLength": 1,"maxLength": 512},
        "retryable": {"type": "boolean"}
      }
    }
  }
}
