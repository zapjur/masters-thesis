#!/usr/bin/env bb
(require '[babashka.classpath :as cp]
         '[clojure.java.io :as io])

;; Resolve the launcher itself so a PATH symlink works from any directory.
(let [root (-> *file* io/file .getCanonicalFile .getParentFile .getParentFile)]
  (cp/add-classpath (str (io/file root "src")))
  (cp/add-classpath (str (io/file root ".." "infra" "feasibility")))
  (require 'mt.core)
  (try
    (apply (resolve 'mt.core/-main) *command-line-args*)
    (catch Exception error
      (binding [*out* *err*]
        (println (str "mt: " (.getMessage error))))
      (System/exit 1))))
