["CREATE TABLE operational_state (id INTEGER PRIMARY KEY CHECK (id = 1), body TEXT NOT NULL)"
 "CREATE TABLE execution_events (sequence INTEGER PRIMARY KEY, id TEXT NOT NULL UNIQUE, command_id TEXT NOT NULL, type TEXT NOT NULL, at_ms INTEGER NOT NULL, body TEXT NOT NULL)"
 "CREATE TABLE effect_intents (id TEXT PRIMARY KEY, command_id TEXT NOT NULL UNIQUE, created_sequence INTEGER NOT NULL REFERENCES execution_events(sequence), last_sequence INTEGER NOT NULL REFERENCES execution_events(sequence), mode TEXT NOT NULL CHECK (mode IN ('fixture/succeed','fixture/fail')), status TEXT NOT NULL CHECK (status IN ('pending','active','completed','failed','uncertain')))"
 "CREATE INDEX effects_by_status ON effect_intents(status, created_sequence)"]
