{:paths ["controller/src" "controller/resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        integrant/integrant {:mvn/version "1.0.1"}
        metosin/malli {:mvn/version "0.20.3"}
        ring/ring-jetty-adapter {:mvn/version "1.15.6"}
        metosin/reitit-ring {:mvn/version "0.11.0"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.4.72"}
        org.xerial/sqlite-jdbc {:mvn/version "3.53.1.0"}
        org.clojure/data.json {:mvn/version "2.5.2"}}
 :aliases {:controller {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                        :main-opts ["-m" "mt.controller.system"]}
           :test {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                  :extra-paths ["controller/test"]
                  :main-opts ["-m" "mt.controller.test-runner"]}}}
