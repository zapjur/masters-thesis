{:paths ["src" "../infra/feasibility"]
 :tasks {mt {:doc "Run the initial mt feasibility command"
             :task (do (require 'mt.core)
                       (apply (resolve 'mt.core/-main) *command-line-args*))}
         test {:doc "Test process handling and SSH argument validation"
               :extra-paths ["test"]
               :task (do (require 'mt.core-test)
                         (require 'mt.tcp-check-test)
                         (require 'mt.bootstrap-test)
                         (let [result (clojure.test/run-tests 'mt.core-test 'mt.tcp-check-test 'mt.bootstrap-test)]
                           (when (pos? (+ (:fail result) (:error result)))
                             (System/exit 1))))}}}
